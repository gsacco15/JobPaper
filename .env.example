# Settings storage (business name, phone, logo, markup, tax, terms) — the only
# thing JobPaper stores. Upstash Redis or Vercel KV REST credentials.
# Without these, settings live in memory and reset when the server restarts.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / _TOKEN also work, with or without a custom prefix like STORAGE_.)

# Local development only: the user id to use when the host sends none
# (MCP Inspector, curl). Never set this in production.
JOBPAPER_DEV_USER=

# Image origins the panel may load attached photos from (comma-separated).
JOBPAPER_PHOTO_DOMAINS=https://*.oaiusercontent.com,https://*.openai.com

PORT=8787

# Vercel deployments require verified Clerk OAuth identities automatically.
# Set JOBPAPER_AUTH_REQUIRED=true to rehearse OAuth outside Vercel.
JOBPAPER_AUTH_REQUIRED=
# Provision these through Vercel's Clerk integration; keep the secret server-side.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
JOBPAPER_CLERK_ISSUER=https://clerk.jobpaperapp.com
JOBPAPER_MCP_RESOURCE_URL=https://jobpaperapp.com/mcp
# Clerk: scope jobpaper; publish CIMD; require PKCE; include audience; opaque tokens.
