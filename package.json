{
  "name": "jobpaper",
  "version": "0.1.0",
  "private": true,
  "description": "JobPaper — turns a contractor's notes and photos into estimates, change orders, and job reports you can send as a PDF.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@openai/mcp-extensions": "^0.1.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "build:app": "vite build && vite build --config vite.download.config.ts && node scripts/gen-assets.mjs",
    "build:server": "esbuild src/server/node.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "build": "npm run build:app && npm run build:server",
    "start": "node dist/server.mjs",
    "dev": "npm run build:app && JOBPAPER_DEV_USER=dev tsx src/server/node.ts",
    "preview": "vite --open '/index.html?demo=estimate'",
    "typecheck": "node scripts/gen-assets.mjs && tsc -p .",
    "test": "vitest run",
    "test:unit": "vitest run test/shared.test.ts test/server.test.ts",
    "screenshots": "node scripts/screenshots.mjs docs/screenshots && mkdir -p public/screenshots && cp docs/screenshots/*.png public/screenshots/",
    "pdf-samples": "node scripts/pdf-samples.mjs docs/samples",
    "check": "npm run build && npm run typecheck && npm test",
    "package-plugin": "node scripts/package-plugin.mjs"
  }
}
